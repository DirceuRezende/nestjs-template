# Desenvolvimento local: cp .env.example .env (o .env não é commitado). Valores = docker-compose.yml.
# Variável já definida no ambiente vence o .env.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://users:users@localhost:5432/users
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Obrigatório fora de development, >= 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
OUTBOX_POLL_INTERVAL_MS=1000

# OpenTelemetry (Grafana LGTM do compose em http://localhost:3000)
OTEL_SERVICE_NAME=user-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true
